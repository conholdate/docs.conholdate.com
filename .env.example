QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=conholdate_docs_pre_alpha
QDRANT_VECTOR_SIZE=4096

DOCS_OWNER_SOURCE_REPO=D:/git/GroupDocs.Viewer-Docs
DOCS_OWNER_SOURCE_DOCS=net/getting-started
DOCS_OWNER_TARGET_REPO=D:/git/docs.conholdate.com
DOCS_OWNER_TARGET_DOCS_ROOT=docs-net/viewer/getting-started
DOCS_OWNER_TARGET_STATIC_ROOT=static/net/viewer
DOCS_OWNER_TARGET_LOCALE_ROOT_PATTERN=i18n/{locale}/docusaurus-plugin-content-docs-net/current/viewer/getting-started
DOCS_OWNER_DOCS_URL_PREFIX=/net/viewer

EMBEDDINGS_API_URL=https://llm.myorg.com/v1/embeddings
EMBEDDINGS_API_KEY=your_access_key
EMBEDDINGS_MODEL=qwen3-embedding-8b
DOCS_OWNER_SEARCH_API_URL=http://127.0.0.1:3022/api/search

TRANSLATION_API_URL=https://llm.myorg.com/v1/chat/completions
TRANSLATION_API_KEY=your_access_key
TRANSLATION_MODEL=qwen3-next
TRANSLATION_TARGET_LOCALE=es
TRANSLATION_SOURCE_ROOT=docs-net/viewer/getting-started
TRANSLATION_MAX_CHARS=12000
TRANSLATION_RETRIES=2
TRANSLATION_RETRY_DELAY_MS=3000

# By default, search indexing discovers active Docusaurus docs roots:
# docs-net, net_versioned_docs/version-*, and
# i18n/{locale}/docusaurus-plugin-content-docs-net/{current|version-*}.
# Use DOCS_INDEX_ROOTS only to override discovery for focused local tests.
# DOCS_INDEX_ROOTS=docs-net;i18n/es/docusaurus-plugin-content-docs-net/current
DOCS_SITE_BASE_URL=http://127.0.0.1:3000
